---
import Layout from '../layouts/Layout.astro';
import { PROJECTS } from '../lib/projects';
---

<Layout
  title="Projects"
  description="Projects by Kat Bella."
  includePixel={false}
  width="wide"
>
  <section>
    <h1>Projects</h1>
    <p class="intro">
      These are just a few things I’ve worked on that I’m proud of or am
      currently working on independently.
    </p>
    <ul class="projects">
      {PROJECTS.map((project, index) => {
        return (
          <li>
            <a
              class:list={['thumb', { 'has-light': project.imageLight }]}
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
            >
              {project.image ? (
                <>
                  <img
                    class="img-dark"
                    src={project.image}
                    alt={project.imageAlt ?? ''}
                    width="384"
                    height="216"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                  {project.imageLight && (
                    <img
                      class="img-light"
                      src={project.imageLight}
                      alt={project.imageAlt ?? ''}
                      width="384"
                      height="216"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </>
              ) : (
                <project.icon size={28} aria-hidden="true" />
              )}
            </a>
            <div class="details">
              <h2>
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  {project.title}
                </a>
              </h2>
              {project.description && (
                <p class="description" set:html={project.description} />
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<style>
  h1 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .intro {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .projects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .thumb {
    flex: 0 0 200px;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    overflow: hidden;
    color: var(--accent);
  }

  .thumb:hover {
    border-color: var(--accent);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The light variant only shows (and loads) in light mode. */
  .img-light {
    display: none;
  }

  :global([data-theme='light']) .has-light .img-dark {
    display: none;
  }

  :global([data-theme='light']) .has-light .img-light {
    display: block;
  }

  h2 {
    font-size: 1.1rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  h2 a {
    color: var(--text);
  }

  h2 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .description :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.08em;
  }

  @media (max-width: 600px) {
    .projects {
      gap: 3rem;
    }

    li {
      flex-direction: column;
      gap: 1rem;
    }

    .thumb {
      flex: none;
      width: 100%;
    }
  }
</style>

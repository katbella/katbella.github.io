---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <h1>
    Hi, I'm{' '}
    <a href="mailto:kat@katbella.com" aria-label="Contact Kat via email">
      Kat
    </a>
    .
  </h1>
  <h2>I do web things. And video game things. And music things.</h2>
  <p>
    This is where I keep some of my <a href="/projects">projects</a>,{' '}
    <a href="/notes">notes</a>, and other things I’m working on.
  </p>
</Layout>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  h1 a {
    color: var(--accent);
  }

  h1 a:hover {
    text-decoration: none;
    opacity: 0.8;
  }

  h2 {
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: var(--text-muted);
    font-weight: 400;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  p a {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.08em;
  }
</style>

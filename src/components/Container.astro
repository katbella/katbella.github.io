---
interface Props {
  width?: 'default' | 'reading' | 'wide';
}

const { width = 'default' } = Astro.props;
---

<div class:list={['container', width]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: 640px;
    padding: 4rem 2rem;
    margin: 0 auto;
  }

  .container.reading {
    max-width: 720px;
  }

  .container.wide {
    max-width: 900px;
  }

  @media (min-width: 768px) {
    .container {
      margin-inline-start: 8vw;
      margin-inline-end: 0;
    }

    .container.reading,
    .container.wide {
      width: calc(100% - 8vw);
    }
  }
</style>
